#!/usr/bin/env bash
# Ask the local Ollama "Nimble" decision model one question about text on stdin.
#
#   nimble-ask yesno  "<question>"                       < file   -> "yes 0.97" | "no 0.03"
#   nimble-ask choice "<question>" label="desc" ...      < file   -> "<label> 0.93"
#
# The number is P(yes) for yesno and the chosen label's probability for choice.
# Exit 0 = answered, 2 = Nimble off/unreachable/bad answer (fall back to reading the text).
# Long input is cut to its TAIL (~6K tokens). Env: NIMBLE_URL, NIMBLE_MODEL, NIMBLE_HOOKS=0,
# NIMBLE_TIMEOUT (seconds, default 30, covers a cold model load).
set -u
d="$(dirname "$0")"; if [ -f "$d/nimble.sh" ]; then . "$d/nimble.sh"; else . "$d/../../scripts/nimble.sh"; fi

kind="${1:-}"; question="${2:-}"
[ -n "$kind" ] && [ -n "$question" ] || { sed -n '2,11p' "$0" >&2; exit 64; }
shift 2
q=$(printf '%s' "$question" | _nimble_escape)

case "$kind" in
  yesno)
    qs=$(printf '{"a":{"type":"noul","instructions":"%s"}}' "$q")
    resp=$(nimble_ask "${NIMBLE_TIMEOUT:-30}" "$qs") || exit 2
    v=$(nimble_get "$resp" a noul) || exit 2
    if nimble_ge "$v" 0.5; then echo "yes $v"; else echo "no $v"; fi ;;
  choice)
    [ $# -ge 2 ] || { echo "choice needs at least two label=description pairs" >&2; exit 64; }
    crit=""
    for pair in "$@"; do
      label="${pair%%=*}"; desc="${pair#*=}"; [ "$desc" = "$pair" ] && desc="$label"
      crit="$crit${crit:+,}\"$(printf '%s' "$label" | _nimble_escape)\":\"$(printf '%s' "$desc" | _nimble_escape)\""
    done
    qs=$(printf '{"a":{"type":"choice","instructions":"%s","criteria":{%s}}}' "$q" "$crit")
    resp=$(nimble_ask "${NIMBLE_TIMEOUT:-30}" "$qs") || exit 2
    c=$(nimble_get "$resp" a choice) || exit 2
    p=$(nimble_get "$resp" a p) || p="?"
    echo "$c $p" ;;
  *) echo "kind must be yesno or choice" >&2; exit 64 ;;
esac
